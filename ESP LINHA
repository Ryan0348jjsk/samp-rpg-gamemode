{$CLEO .cs}
{$INCLUDE SF}

0000:

repeat
    wait 0
until SAMP.Available()

while true
    wait 0

    if SAMP.IsPlayerConnected(0)
    then
        for 0@ = 0 to 999
            if SAMP.IsPlayerConnected(0@)
            then
                if 0@ <> SAMP.GetLocalPlayerID()
                then
                    SAMP.GetPlayerPos(0@, 1@, 2@, 3@)
                    SAMP.GetPlayerColor(0@, 4@)
                    
                    // Desenhar linha do centro da tela até o jogador
                    SF_DrawLineFromScreenCenterTo3D(1@, 2@, 3@, 0xFF0000FF) // Cor vermelha (RGBA)
                end
            end
        end
    end
end
